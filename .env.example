# ================= 登录认证 =================
# 登录用户名
APP_USERNAME=admin
# 执行 `pnpm hash "你的密码"` 生成哈希后填在这里（必填，服务端不保存明文）
APP_PASSWORD_HASH=
# ================= 会话 =================
# 会话签名密钥（建议 32 位以上随机字符串）。留空会自动生成并保存到 data/.session-secret
SESSION_SECRET=
# 登录有效期（小时），默认 7 天
SESSION_TTL_HOURS=168
# 修改此值可一次性让所有已登录会话失效
SESSION_VERSION=1
# 通过 HTTPS 访问时请设为 true，Cookie 只会走加密连接
COOKIE_SECURE=false
# ================= 服务与端口 =================
# 前端端口（开发模式必填，Vite 使用该端口；生产模式仅用于推导后端端口）
WEB_PORT=5173
# 后端端口（只使用这一个变量名）；留空表示自动使用 WEB_PORT + 1
SERVER_PORT=3456
HOST=0.0.0.0
# 部署在 openresty/nginx 反代后面时打开，用于拿到真实客户端 IP
TRUST_PROXY=true
# 对外的访问地址，用于生成分享链接（例如 https://sub.example.com）
PUBLIC_BASE_URL=
# 可选：仅允许这些 IP / CIDR 访问（留空表示不限制），例如 1.2.3.4,10.0.0.0/8
ALLOWED_IPS=
# 可选：允许规则集使用内网/本机地址的规则文件链接（默认 false；仅在你自建规则镜像时开启）
ALLOW_PRIVATE_RULE_URLS=false
# 可选：数据目录，默认 ./data
# DATA_DIR=
